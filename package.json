{
  "name": "yldfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "preview": "wrangler dev",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='**/integration/**'",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:curve": "bun x tsx test-stableswap-exact.ts && bun x tsx test-cryptoswap-exact.ts",
    "compare:cvxcrv": "npx tsx scripts/compare-cvxcrv-routes.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'pnpm type-check'"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ensofinance/sdk": "^2.0.12",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.1",
    "@yldfi/curve-amm-math": "^1.0.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.47.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@opennextjs/cloudflare": "^1.17.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.71.0"
  }
}
