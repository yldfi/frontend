{
  "name": "yldfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "pnpm exec opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='**/integration/**'",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:curve": "bun x tsx test-stableswap-exact.ts && bun x tsx test-cryptoswap-exact.ts",
    "compare:cvxcrv": "npx tsx scripts/compare-cvxcrv-routes.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'pnpm type-check'"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ensofinance/sdk": "2.5.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.11.2",
    "@yldfi/curve-amm-math": "1.3.0",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.0",
    "lucide-react": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "viem": "2.55.11",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/dotenv": "8.2.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "cross-fetch": "4.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "next": "16.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  },
  "packageManager": "pnpm@10.7.0"
}
