{
  "name": "yldfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "pnpm exec opennextjs-cloudflare build",
    "populate:cloudflare": "pnpm exec opennextjs-cloudflare populateCache remote",
    "preview": "wrangler dev",
    "deploy": "pnpm build:cloudflare && pnpm populate:cloudflare && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typegen:app": "wrangler types --env-file /dev/null --include-env=false cloudflare-runtime.d.ts",
    "typegen:workers": "wrangler types --config workers/wrangler.toml --env-file /dev/null --include-env=false workers/worker-runtime.d.ts && wrangler types --config workers/wrangler.toml --env-file /dev/null --include-runtime=false --env-interface CacheWorkerEnv workers/cache-worker-env.d.ts && wrangler types --config workers/wrangler.x-weekly-apy.toml --env-file /dev/null --include-runtime=false --env-interface XWeeklyApyEnv workers/x-weekly-apy-env.d.ts",
    "typegen": "pnpm typegen:app && pnpm typegen:workers",
    "typegen:check:app": "wrangler types --env-file /dev/null --include-env=false --check cloudflare-runtime.d.ts",
    "typegen:check:workers": "wrangler types --config workers/wrangler.toml --env-file /dev/null --include-env=false --check workers/worker-runtime.d.ts && wrangler types --config workers/wrangler.toml --env-file /dev/null --include-runtime=false --env-interface CacheWorkerEnv --check workers/cache-worker-env.d.ts && wrangler types --config workers/wrangler.x-weekly-apy.toml --env-file /dev/null --include-runtime=false --env-interface XWeeklyApyEnv --check workers/x-weekly-apy-env.d.ts",
    "typegen:check": "pnpm typegen:check:app && pnpm typegen:check:workers",
    "type-check": "pnpm typegen:check && tsc --noEmit && tsc --noEmit -p workers/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project integration-dom",
    "test:coverage": "vitest run --coverage --project unit",
    "test:sweep": "vitest run --project sweep",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:curve": "bun x tsx test-stableswap-exact.ts && bun x tsx test-cryptoswap-exact.ts",
    "compare:cvxcrv": "npx tsx scripts/compare-cvxcrv-routes.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'pnpm type-check'"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ensofinance/sdk": "2.6.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.4",
    "@xyflow/react": "12.12.0",
    "@yldfi/curve-amm-math": "1.5.2",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.7",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/dotenv": "8.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-fetch": "4.1.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "overrides": {
      "cuer>qr": "0.5.5",
      "@babel/core@<7.29.6": "^7.29.6",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "defu@<6.1.5": "^6.1.5",
      "flatted@<3.4.2": "^3.4.2",
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "zod@>=4.0.0 <4.6.6": "^4.6.7",
      "h3@<1.15.9": "^1.15.9",
      "hono@<4.13.7": "^4.13.7",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "minimatch@>=3.0.0 <3.1.3": "^3.1.3",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "proxy-addr@<2.0.8": "^2.0.8",
      "sharp@<0.35.5": "^0.35.5",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "ua-parser-js@>=2.0.0 <2.0.10": "^2.0.10",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "undici@>=8.0.0 <8.10.2": "^8.10.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "@solana/rpc-subscriptions-channel-websocket>ws": "^8.21.0"
    }
  },
  "packageManager": "pnpm@10.34.6"
}
