# WalletConnect Project ID
# Get yours at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Enso Finance API Key (server-side only, proxied via /api/enso)
# Get yours at https://developers.enso.build
ENSO_API_KEY=

# Cloudflare API Token (for wrangler deploy)
# Has permissions: Workers Scripts, Workers KV, Workers Routes
CLOUDFLARE_API_TOKEN=

# Tenderly Simulation API (server-side only)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Nonce signing secret for /api/simulate
SIMULATION_NONCE_SECRET=

# Debug/archive RPC used by integration tests and /api/debug-trace.
# A provider URL that carries its key in the path needs no Authorization
# header. DEBUG_RPC_AUTH is only for proxies that still require basic auth
# (value without the "Basic " prefix).
DEBUG_RPC_URL=
DEBUG_RPC_AUTH=

# Etherscan API Key (for integration tests - token holder lookups)
# Get yours at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Token holders are fetched from the public Blockscout API (no API key required)

# Token Holders API (for integration tests)
# Shared secret for authenticating with /api/token-holders endpoint
# Generate with: openssl rand -base64 32
TOKEN_HOLDER_API_KEY=

# Token Holders API URL (defaults to localhost:3000 for local dev)
# Set to production URL in CI: https://your-domain.com/api/token-holders
TOKEN_HOLDER_API_URL=

# Cache worker (local dev only; deployed, the site always uses its CACHE_WORKER
# service binding and the cache worker has no public address).
#
# With Cloudflare credentials (CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in
# the environment; ask the maintainer), set this to 1 and `pnpm dev` reaches the
# deployed cache worker through a remote binding. The first requests after
# startup may 500 until the remote connection is up (about 10-20 s).
# YLDFI_DEV_REMOTE_BINDINGS=1
#
# Without credentials, leave the flag unset and set CACHE_WORKER_URL to the full
# URL of a running cache worker's /api/vaults endpoint (for example from
# `wrangler dev --config workers/wrangler.toml`). /api/history resolves its own
# path against this same worker. With neither, /api/vaults and /api/history
# both return 500 {"error":"Configuration error"}.
CACHE_WORKER_URL=

# Weekly social automation worker
# These are set on the separate workers/wrangler.x-weekly-apy.toml deployment,
# not required for the main Next.js app.
SOCIAL_RUN_SECRET=
CLOUDFLARE_ACCOUNT_ID=
# This worker uses its own CLOUDFLARE_API_TOKEN secret (Browser Rendering
# permission), set with `wrangler secret put`; see workers/README-x-weekly-apy.md.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_REFRESH_TOKEN=

# Optional
# Shared key for the dev-only /api/debug-trace endpoint; when set, requests
# must send it as the x-debug-key header.
DEBUG_TRACE_API_KEY=

# Google Analytics measurement ID; unset disables analytics.
NEXT_PUBLIC_GA_ID=

# Set to 1 at build time to keep the /debug wallet diagnostics page in a production build
# NEXT_PUBLIC_ENABLE_DEBUG_PAGE=1

# Local Anvil fork RPC. Uncomment to send all app traffic to the fork instead
# of the public RPC fallback.
# NEXT_PUBLIC_ANVIL_RPC=http://127.0.0.1:8545

# Tenderly virtual testnet RPC and the address impersonated on it.
# Development only.
NEXT_PUBLIC_TENDERLY_VNET_RPC=
NEXT_PUBLIC_TENDERLY_VNET_ADDRESS=

# Extra Alchemy RPC used by the integration tests as the simulation RPC when
# DEBUG_RPC_URL is unset.
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Set to "off" to keep the hardcoded RPC list only and skip the chainid.network
# discovery fetch.
RPC_DYNAMIC_DISCOVERY=

# Enso tuning, all optional.
# Delay between Enso API calls in ms (default 0 = no delay).
# ENSO_RATE_LIMIT_MS=0
# Retries for failed Enso API calls (default 3).
# ENSO_MAX_RETRIES=3
# Timeout per Enso API call in ms (default 20000; values below 1000 are ignored).
# ENSO_CALL_TIMEOUT_MS=20000
# Extra buffer in basis points on hybrid route min-output checks (default 200).
# ENSO_HYBRID_EXTRA_BUFFER_BPS=200
