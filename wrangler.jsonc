{
  "name": "yldfi",
  "main": "workers/yldfi-edge.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Caching is DISABLED. Its cache key does NOT reliably partition on
  // `Vary: cf-ipcountry`, so a page cached for an allowed region was served to a
  // blocked region (GB), bypassing the regulatory geo-block. Re-enable only with a
  // country-keyed design (e.g. a gateway entrypoint passing country via ctx.props).
  "cache": {
    "enabled": false
  },
  "observability": {
    "enabled": true,
    // Full sampling: traffic is low, and 10% sampling lost the [Simulate] events
    // needed to diagnose a user-reported empty simulation preview (2026-10-31).
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "VAULT_CACHE",
      "id": "196d1aceae10469bb4bde0495b3e3ae0"
    },
    {
      "binding": "EXPLORER_CACHE",
      "id": "f7acb436175d46b0a9da72a2d304294d"
    }
  ],
  // Shared rate limits for the routes that spend an upstream quota per call.
  // Counts are shared by all instances in a Cloudflare location and are
  // approximate, not an exact global counter.
  // namespace_id values must be unique across the whole Cloudflare account; this app uses 3001-3099.
  "ratelimits": [
    {
      "name": "RL_ENSO",
      "namespace_id": "3001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_SIMULATE",
      "namespace_id": "3002",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "RL_SIMULATE_NONCE",
      "namespace_id": "3003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_TOKEN_HOLDERS",
      "namespace_id": "3004",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_EXPLORER",
      "namespace_id": "3005",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // The site calls the cache worker directly through this binding, so no public
  // hostname is needed for /api/vaults and /api/history (src/lib/cache-worker.ts).
  "services": [{ "binding": "CACHE_WORKER", "service": "yldfi-cache" }],
  "d1_databases": [
    {
      "binding": "LOGS",
      "database_name": "yldfi-logs",
      "database_id": "b2f2df39-1663-4507-8e58-5a21c4b14770"
    }
  ],
  "routes": [
    { "pattern": "yldfi.co/*", "zone_name": "yldfi.co" },
    { "pattern": "www.yldfi.co/*", "zone_name": "yldfi.co" }
  ]
}
