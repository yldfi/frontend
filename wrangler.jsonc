{
  "name": "yldfi",
  "main": "workers/yldfi-edge.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Caching is DISABLED. Its cache key does NOT reliably partition on
  // `Vary: cf-ipcountry`, so a page cached for an allowed region was served to a
  // blocked region (GB), bypassing the regulatory geo-block. Re-enable only with a
  // country-keyed design (e.g. a gateway entrypoint passing country via ctx.props).
  "cache": {
    "enabled": false
  },
  "observability": {
    "enabled": true,
    // Full sampling: traffic is low, and 10% sampling lost the [Simulate] events
    // needed to diagnose a user-reported empty simulation preview (2026-10-31).
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "VAULT_CACHE",
      "id": "196d1aceae10469bb4bde0495b3e3ae0"
    },
    {
      "binding": "EXPLORER_CACHE",
      "id": "f7acb436175d46b0a9da72a2d304294d"
    }
  ],
  "d1_databases": [
    {
      "binding": "LOGS",
      "database_name": "yldfi-logs",
      "database_id": "b2f2df39-1663-4507-8e58-5a21c4b14770"
    }
  ],
  "routes": [
    { "pattern": "yldfi.co/*", "zone_name": "yldfi.co" },
    { "pattern": "www.yldfi.co/*", "zone_name": "yldfi.co" }
  ]
}
