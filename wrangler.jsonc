{
  "name": "yldfi",
  "main": "workers/yldfi-edge.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "VAULT_CACHE",
      "id": "196d1aceae10469bb4bde0495b3e3ae0"
    },
    {
      "binding": "EXPLORER_CACHE",
      "id": "f7acb436175d46b0a9da72a2d304294d"
    }
  ],
  "d1_databases": [
    {
      "binding": "LOGS",
      "database_name": "yldfi-logs",
      "database_id": "b2f2df39-1663-4507-8e58-5a21c4b14770"
    }
  ],
  "routes": [
    { "pattern": "yldfi.co/*", "zone_name": "yldfi.co" },
    { "pattern": "www.yldfi.co/*", "zone_name": "yldfi.co" }
  ]
}
